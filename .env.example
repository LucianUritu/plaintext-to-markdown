# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_SCOPE=read:user read:org repo workflow

# Local app security
SESSION_SECRET=
SESSION_MAX_AGE_SECONDS=28800

# Book completion email notifications
COMPLETION_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
